function positionTooltip(el){const r=el.getBoundingClientRect(), gap=10, vw=window.innerWidth, vh=window.innerHeight; hoverSummary.style.left='14px';hoverSummary.style.top='14px';const tw=hoverSummary.offsetWidth, th=hoverSummary.offsetHeight;let left=r.left; if(left+tw>vw-14) left=vw-tw-14; if(left<14) left=14; let top=r.bottom+gap; if(top+th>vh-14) top=r.top-th-gap; if(top<14) top=14; hoverSummary.style.left=left+'px';hoverSummary.style.top=top+'px';}
function showTooltip(el){const i=+el.dataset.tipIdx; if(!Number.isInteger(i)||!data[i]) return; hoverSummary.textContent=data[i].summary;hoverSummary.classList.add('show');hoverSummary.setAttribute('aria-hidden','false');positionTooltip(el)}
function hideTooltip(){hoverSummary.classList.remove('show');hoverSummary.setAttribute('aria-hidden','true')}
function render(){
 let arr=data.filter(x=>(field==='ALL'||x.field===field)&&(cat.value==='ALL'||x.category===cat.value));
 const term=q.value.trim().toLowerCase(); if(term) arr=arr.filter(x=>(x.title+' '+x.summary+' '+x.field+' '+x.category).toLowerCase().includes(term));
 arr=[...arr].sort((a,b)=>{ if(sort.value==='title') return fieldRank(a.field)-fieldRank(b.field) || a.title.localeCompare(b.title,'ko'); if(sort.value==='category') return categoryRank(a.category)-categoryRank(b.category) || fieldRank(a.field)-fieldRank(b.field) || a.title.localeCompare(b.title,'ko'); return fieldRank(a.field)-fieldRank(b.field) || categoryRank(a.category)-categoryRank(b.category) || a.title.localeCompare(b.title,'ko'); });
 rows.innerHTML=arr.length?arr.map((x,i)=>`<article class="row ${fieldClassName(x.field)}" tabindex="0" data-idx="${data.indexOf(x)}" aria-label="${x.url?'원문 기사 열기':'기사 상세보기'}: ${x.title}"><div><span class="pill ${fieldClassName(x.field)}">${x.field}</span></div><div class="category">${x.category}</div><div class="title" tabindex="0" data-tip-idx="${data.indexOf(x)}" aria-describedby="hoverSummary">${x.title}</div><div class="arrow">${x.url?'↗':'›'}</div></article>`).join(''):`<div class="empty">조건에 맞는 기사가 없음</div>`;
 document.querySelectorAll('.row').forEach(el=>{el.addEventListener('click',()=>openArticle(+el.dataset.idx)); el.addEventListener('keydown',e=>{if(e.key==='Enter'&&e.target===el) openArticle(+el.dataset.idx)})});
 document.querySelectorAll('.title[data-tip-idx]').forEach(el=>{el.addEventListener('mouseenter',()=>showTooltip(el));el.addEventListener('mouseleave',hideTooltip);el.addEventListener('focus',()=>showTooltip(el));el.addEventListener('blur',hideTooltip);el.addEventListener('click',e=>{e.stopPropagation();openArticle(+el.dataset.tipIdx)});el.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();openArticle(+el.dataset.tipIdx)}})});
 renderCategoryDistribution();
 renderSignals();
}
function openArticle(i){const x=data[i]; hideTooltip(); if(x.url){window.open(x.url,'_blank','noopener,noreferrer');}else{openDetail(i);}}
function openDetail(i){const x=data[i], fieldEl=document.getElementById('mField'); fieldEl.textContent=x.field; fieldEl.className='pill '+fieldClassName(x.field); document.getElementById('mCat').textContent=x.category; document.getElementById('mTitle').textContent=x.title; document.getElementById('mSummary').textContent=x.summary; const a=document.getElementById('mLink'); if(x.url){a.href=x.url;a.style.display='inline-block'}else{a.removeAttribute('href');a.style.display='none'} modal.classList.add('show');modal.setAttribute('aria-hidden','false')}
function closeModal(){modal.classList.remove('show');modal.setAttribute('aria-hidden','true')}
document.querySelectorAll('.field-card,.metric-card:first-child').forEach(b=>b.addEventListener('click',()=>{field=b.dataset.field;document.querySelectorAll('.metric-card').forEach(x=>x.classList.remove('active'));b.classList.add('active');render()}));
[q,cat,sort].forEach(el=>el.addEventListener(el===q?'input':'change',render)); document.getElementById('reset').addEventListener('click',()=>{field='ALL';q.value='';cat.value='ALL';sort.value='field';document.querySelectorAll('.metric-card').forEach(x=>x.classList.toggle('active',x.dataset.field==='ALL'));render()});
document.getElementById('close').addEventListener('click',closeModal);modal.addEventListener('click',e=>{if(e.target===modal)closeModal()});document.addEventListener('keydown',e=>{if(e.key==='Escape'){hideTooltip();closeModal()}});window.addEventListener('scroll',hideTooltip,{passive:true});window.addEventListener('resize',hideTooltip);render();
</script></body></html>
